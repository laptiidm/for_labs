[93.886051, "o", "\r\n\u001b[?2004l\r"]
[93.889408, "o", "#include <cstdio>\r\n\r\nint main(int argc, char *argv[])\r\n{\r\n    if (argc != 2) {\r\n        std::fprintf(stderr, \"Usage: %s <file_path>\\n\", argv[0]);\r\n        return 1;\r\n    }\r\n\r\n    FILE *file = std::fopen(argv[1], \"r\");\r\n\r\n    if (file == nullptr) {\r\n        std::fprintf(stderr, \"помилка, файл неможна відкрити: %s\\n\", argv[1]);\r\n        return 1;\r\n    }\r\n\r\n    if (std::fseek(file, 0, SEEK_SET) != 0) {\r\n        std::fprintf(stderr, \"помилка, файл не знайдено file\\n\");\r\n        std::fclose(file);\r\n        return 1;\r\n    }\r\n\r\n    int ch;\r\n\r\n    while ((ch = std::fgetc(file)) != EOF) {\r\n        std::fputc(ch, stdout);\r\n    }\r\n\r\n    std::fclose(file);\r\n\r\n    return 0;\r\n}\r\n\r\n"]
