[8.483996, "o", "\r\n\u001b[?2004l\r"]
[8.4868, "o", "#include <iostream>\r\n#include <unistd.h>\r\n\r\nint main() {\r\n    std::cout << \"програма стартувала. PID: \" << getpid() << std::endl;\r\n\r\n    pid_t pid = fork();\r\n\r\n    if (pid == -1) {\r\n        std::cerr << \"fork() не спрацював коректно\" << std::endl;\r\n        return 1;\r\n    }\r\n\r\n    std::cout << \"процес після fork(). PID: \" << getpid() << std::endl;\r\n\r\n    sleep(30);\r\n\r\n    return 0;\r\n}\r\n"]
